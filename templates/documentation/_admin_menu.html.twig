{#
	Edition menu (⋯) of a page, a folder or the documentation home : edit, new page / folder, delete
	Included only for the users having the edit_security role.

	parent        : folder of the new pages / folders ("" : documentation root)
	next_position : default position of a new page / folder
	edit_path     : page to edit (optional)
	delete_path   : page or empty folder to delete (optional), delete_type : page | folder, delete_name : displayed name
#}
{% set edit_path = edit_path | default(null) %}
{% set delete_path = delete_path | default(null) %}
{% set delete_type = delete_type | default('page') %}
{% set delete_name = delete_name | default('') %}

<div class="dropdown ms-auto">
	<button type="button" class="ali-docs-icon-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ 'Page options' | trans({}, 'ali_docs') }}">
		<i class="bi bi-three-dots"></i>
	</button>
	<ul class="dropdown-menu dropdown-menu-end shadow-sm">
		{% if edit_path %}
			<li>
				<a class="dropdown-item" href="{{ path('ali_docs_admin_edit', { 'doc_key': doc_key, 'path': edit_path }) }}" data-turbo-frame="_top">
					<i class="bi bi-pencil"></i>
					{{- 'Edit' | trans({}, 'ali_docs') -}}
				</a>
			</li>
			<li><hr class="dropdown-divider"></li>
		{% endif %}
		<li>
			<button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#ali-docs-create-modal" data-ali-docs-create="page">
				<i class="bi bi-file-earmark-plus"></i>
				{{- 'New page' | trans({}, 'ali_docs') -}}
			</button>
		</li>
		<li>
			<button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#ali-docs-create-modal" data-ali-docs-create="folder">
				<i class="bi bi-folder-plus"></i>
				{{- 'New folder' | trans({}, 'ali_docs') -}}
			</button>
		</li>
		{% if delete_path %}
			<li><hr class="dropdown-divider"></li>
			<li>
				<form method="post" action="{{ path('ali_docs_admin_delete', { 'doc_key': doc_key }) }}" data-turbo="false"
					data-ali-docs-confirm="{{ (delete_type == 'folder' ? 'Delete the folder "%name%"?' : 'Delete the page "%name%"?') | trans({ '%name%': delete_name }, 'ali_docs') }}"
					data-ali-docs-confirm-label="{{ 'Delete' | trans({}, 'ali_docs') }}">
					<input type="hidden" name="_token" value="{{ csrf_token('ali_docs_edit') }}">
					<input type="hidden" name="path" value="{{ delete_path }}">
					<button type="submit" class="dropdown-item ali-docs-dropdown-danger">
						<i class="bi bi-trash3"></i>
						{{- (delete_type == 'folder' ? 'Delete the folder' : 'Delete the page') | trans({}, 'ali_docs') -}}
					</button>
				</form>
			</li>
		{% endif %}
	</ul>
</div>

{# New page / folder : the type is set by the menu button (ali_docs.js) #}
<div class="modal fade ali-docs-modal" id="ali-docs-create-modal" tabindex="-1" aria-labelledby="ali-docs-create-title" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<form class="modal-content" method="post" action="{{ path('ali_docs_admin_create', { 'doc_key': doc_key }) }}" data-turbo="false">
			<div class="modal-header">
				<h2 class="modal-title" id="ali-docs-create-title" data-title-page="{{ 'New page' | trans({}, 'ali_docs') }}" data-title-folder="{{ 'New folder' | trans({}, 'ali_docs') }}">
					{{- 'New page' | trans({}, 'ali_docs') -}}
				</h2>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close' | trans({}, 'ali_docs') }}"></button>
			</div>
			<div class="modal-body">
				<input type="hidden" name="_token" value="{{ csrf_token('ali_docs_edit') }}">
				<input type="hidden" name="type" value="page">
				<input type="hidden" name="parent" value="{{ parent }}">
				<div class="row g-3">
					<div class="col-4">
						<label class="form-label" for="ali-docs-create-position">{{ 'Position' | trans({}, 'ali_docs') }}</label>
						<input class="form-control" type="number" id="ali-docs-create-position" name="position" value="{{ next_position }}" min="0" step="1" required>
					</div>
					<div class="col-8">
						<label class="form-label" for="ali-docs-create-title-input">{{ 'Name' | trans({}, 'ali_docs') }}</label>
						<input class="form-control" type="text" id="ali-docs-create-title-input" name="title" maxlength="100" pattern="[\p{L}\p{N} _\-]+" autocomplete="off" required>
					</div>
				</div>
				<p class="form-text mb-0">{{ 'Letters, numbers, spaces, _ and -. The position sets the order in the menu.' | trans({}, 'ali_docs') }}</p>
			</div>
			<div class="modal-footer">
				<button type="button" class="ali-docs-btn ali-docs-btn-light" data-bs-dismiss="modal">{{ 'Cancel' | trans({}, 'ali_docs') }}</button>
				<button type="submit" class="ali-docs-btn">{{ 'Create' | trans({}, 'ali_docs') }}</button>
			</div>
		</form>
	</div>
</div>
