<nav id="menu" class="ali-docs-nav" aria-label="{{ 'Documentation' | trans({}, 'ali_docs') }}">

	{% for item in tree.getChildren() %}

		{% if item.isDirectory() %}
			{% include '@AliDocs/documentation/_doc_item.html.twig' with { 'doc_key': doc_key, 'item': item, 'current_url': current_url } %}
		{% endif %}

		{% if item.isFile() %}
			{% include '@AliDocs/documentation/_file_item.html.twig' with { 'doc_key': doc_key, 'item': item, 'current_url': current_url } %}
		{% endif %}

	{% endfor %}

</nav>

{% if switch_doc | default | length %}
	<div class="ali-docs-sidebar-footer">
		<div class="dropup">
			<button type="button" class="ali-docs-switch dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
				<i class="bi bi-arrow-left-right"></i>
				<span>{{ 'Go to documentation' | trans({}, 'ali_docs') }}</span>
			</button>
			<ul class="dropdown-menu shadow-sm">
				{# Only the documentations the user can read (filtered by the controller) #}
				{% for doc in switch_doc %}
					<li>
						<a class="dropdown-item" href="{{ path('ali_docs_index', { doc_key : doc.doc_key }) }}">{{ doc.title }}</a>
					</li>
				{% endfor %}
			</ul>
		</div>
	</div>
{% endif %}
